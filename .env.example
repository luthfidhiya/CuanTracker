# Google Service Account credentials
# Get these from your Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the double quotes. Either paste the key on one line with \n escapes (as in
# the downloaded JSON), or paste it across multiple lines inside the quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Spreadsheet ID
# Found in the spreadsheet URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Auth (NextAuth.js) — both are required; login is refused while APP_PASSWORD is empty.
# Signs and encrypts the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=generate_with_openssl_rand_base64_32
# The password you type on the login page.
APP_PASSWORD=your_strong_password_here
